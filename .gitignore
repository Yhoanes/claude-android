# Build staging & compiled artifacts
build/*
!build/lib/
!build/phases/
!build/tools/
dist/*
!dist/.gitkeep
app/gen/
web/generated/

# Track <80 MB split chunks + SHA-256 manifest; ignore reassembled >100 MB archive
core/claude-core.tar.gz
core/*.tar
!core/claude-core.tar.gz.part-*
!core/claude-core.tar.gz.sha256

# Python & Rust build caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
env/rust/*/target/
target/

# Logs, temporary & signature files
*.log
*.tmp
*.bak
*.orig
*.swp
*~
*.idsig

# Operating System files
.DS_Store
Thumbs.db

# Sensitive credentials & keystores (NEVER commit signing keys)
*.keystore
*.jks
*.p12
*.pfx
*.pk8
*.pem
!core/certs/*.pem
!env/overlay/etc/tls/cert.pem
signing.env
keystore.env
*.key
*-token
.env.local

# Scratch / local workspaces
scratch/
