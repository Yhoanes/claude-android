# Claude Code for Android — application identity & SDK floor/ceiling.
# Consumed ONLY via build/tools/gen_android_config.py ->
#   res/values/gen.xml  +  com/cc/ide/BuildConfig.java
# and via build/lib/paths.sh for aapt --min-sdk-version / --target-sdk-version.
# Never hardcode these in AndroidManifest.xml or Java sources.
#
# NOTE: Both PKG (com.cc.ide) and PKG_DEV (com.cc.dev) are 10 ASCII bytes exact
# (matching len("com.termux") == 10), enabling zero-PRoot in-place ELF prefix
# rewriting across glibc (resolv.conf/nsswitch.conf), node, dpkg, bash, rg, and Bionic shared libs.

PKG=com.cc.ide
PKG_DEV=com.cc.dev
APP_NAME=Claude Code
APP_NAME_DEV=Claude Code Dev
VERSION_CODE=20133102
VERSION_NAME=2.1.331-r1
CORE_VERSION=2.1.331
PORT=45177
PORT_DEV=45178
OAUTH_SCHEME=claudecode

# TARGET_SDK=28 MUST stay <= 28 so Android 10-16+ allows execve() directly from
# getFilesDir()/runtime/bin/* and getFilesDir()/usr/bin/* without W^X SELinux blocks.
MIN_API=28
TARGET_SDK=28
