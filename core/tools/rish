#!/system/bin/sh
BASEDIR="${0%/*}"
DEX=""
for d in "$BASEDIR" "$BASEDIR/../shizuku" "/data/user/0/com.cc.ide/files/runtime/shizuku" "/data/data/com.cc.ide/files/runtime/shizuku"; do
  if [ -f "$d/rish_shizuku.dex" ]; then
    DEX="$d/rish_shizuku.dex"
    break
  fi
done
if [ -z "$DEX" ]; then
  echo "rish: rish_shizuku.dex not found" >&2
  exit 1
fi
SDK=$(/system/bin/getprop ro.build.version.sdk 2>/dev/null || echo 0)
if [ "$SDK" -ge 34 ] && [ -w "$DEX" ]; then
  /system/bin/chmod 400 "$DEX" 2>/dev/null || true
fi
[ -z "$RISH_APPLICATION_ID" ] && export RISH_APPLICATION_ID="com.cc.ide"
exec /system/bin/env -u LD_PRELOAD -u LD_LIBRARY_PATH /system/bin/app_process -Djava.class.path="$DEX" /system/bin --nice-name=rish rikka.shizuku.shell.ShizukuShellLoader "$@"
