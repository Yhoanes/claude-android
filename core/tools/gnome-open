#!/system/bin/sh
# Claude Code Android URL opener shim
unset LD_PRELOAD
unset LD_LIBRARY_PATH
RBIN="$(cd "${0%/*}" && pwd)"
FILES_DIR="$(cd "$RBIN/../.." && pwd)"
URL=""
for arg in "$@"; do
  case "$arg" in
    -*) ;;
    *) URL="$arg" ;;
  esac
done
[ -z "$URL" ] && URL="$1"
[ -z "$URL" ] && exit 0
echo "CC_OPEN_URL=$URL"
printf '%s\n' "$URL" >> "$FILES_DIR/.open_url_queue" 2>/dev/null || true
if [ -x /system/bin/am ]; then
  /system/bin/am start -a android.intent.action.VIEW -d "$URL" >/dev/null 2>&1 || true
fi
exit 0
